# =========================================================================
# Tourist Safety App - Master Environment Variables Template
# =========================================================================
# This file serves as a single reference for all environment variables 
# needed across the entire full-stack application (Server, AI, React Clients).
# 
# Instructions for Render.com deployment:
# You can copy and paste the values for these keys directly into the 
# Render Dashboard when you connect your GitHub repository.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Node.js API Service (server)
# -------------------------------------------------------------------------
# Your MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tourist_safety_db?retryWrites=true&w=majority

# Secret key used for signing JWT authentication tokens
# (Can be any long random string)
JWT_SECRET=super_secret_jwt_key_tourist_safety_2026

# The OpenRouter API key for LLM functionality (DeepSeek, LLaMA, etc)
# Get this from https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-...

# (Render will auto-generate PORT and CLIENT_URL based on render.yaml)


# -------------------------------------------------------------------------
# 2. Python AI Service (ai-service)
# -------------------------------------------------------------------------
# The OpenRouter API key is also needed here for Python ML fallbacks
OPENROUTER_API_KEY=sk-or-v1-...

# (Render will auto-generate PORT)


# -------------------------------------------------------------------------
# 3. React Tourist App & Admin Dashboard (client-tourist & client-admin)
# -------------------------------------------------------------------------
# Your Mappls (MapmyIndia) API Key for rendering the interactive map
VITE_MAPPLS_KEY=your_mappls_key_here

# (Render will auto-populate VITE_API_URL and VITE_AI_API_URL from render.yaml)
