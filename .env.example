# Tourist Safety App - Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas cluster)
MONGO_URI=mongodb://localhost:27017/tourist_safety_db

# JWT Secret for Authentication
JWT_SECRET=super_secret_jwt_key_tourist_safety_2026

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Mappls access token for the web map tiles; OSM is used automatically if absent or unavailable.
VITE_MAPPLS_KEY=
